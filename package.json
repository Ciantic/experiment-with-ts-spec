{
  "name": "test-backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run lint:spec",
    "lint:spec": "pnpm --filter spec run lint:spec",
    "generate": "pnpm run generate:schema && pnpm run generate:repositories && pnpm run generate:validation",
    "generate:schema": "pnpm --filter backend run generate:schema",
    "generate:schema:stdout": "pnpm --filter backend run generate:schema:stdout",
    "generate:repositories": "pnpm --filter backend run generate:repositories",
    "generate:validation": "pnpm --filter validation run generate",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run lint && pnpm run generate && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
