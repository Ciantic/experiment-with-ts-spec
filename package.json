{
  "name": "test-backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "pnpm -r run test",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "lint": "pnpm run lint:spec",
    "lint:spec": "pnpm --filter spec run lint:spec",
    "generate": "node scripts/generate.ts",
    "spec": "pnpm run lint:spec && pnpm run generate",
    "generate:schema": "pnpm --filter backend run generate:schema",
    "generate:schema:stdout": "pnpm --filter backend run generate:schema:stdout",
    "generate:repositories": "pnpm --filter backend run generate:repositories",
    "generate:queries": "pnpm --filter backend run generate:queries",
    "generate:validation": "pnpm --filter validation run generate:validation",
    "generate:rest-api": "pnpm --filter backend run generate:rest-api",
    "generate:rest-client": "pnpm --filter backend run generate:rest-client",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run lint && pnpm run generate && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "backend": "workspace:*",
    "spec": "workspace:*",
    "validation": "workspace:*"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
