{
  "name": "test-backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "pnpm -r run test && vitest run",
    "typecheck": "tsc --noEmit && pnpm -r run typecheck",
    "lint": "pnpm run lint:spec && pnpm run lint:operations && pnpm run lint:spec-tests && pnpm run lint:oxlint",
    "lint:spec": "node scripts/spec/lint-spec.ts",
    "lint:operations": "node scripts/backend/generate-operations.ts --check",
    "lint:spec-tests": "node scripts/backend/generate-spec-tests.ts --check",
    "lint:oxlint": "oxlint",
    "generate": "node scripts/generate.ts",
    "generate:schema": "node scripts/infra/generate-postgres-schema.ts",
    "generate:schema:stdout": "node scripts/infra/generate-postgres-schema.ts --stdout",
    "generate:repositories": "node scripts/infra/generate-repositories.ts",
    "generate:queries": "node scripts/infra/generate-queries.ts",
    "generate:operations": "node scripts/backend/generate-operations.ts",
    "generate:spec-tests": "node scripts/backend/generate-spec-tests.ts",
    "generate:validation": "node scripts/sdk/generate-zod-schemas.ts",
    "generate:errors": "node scripts/sdk/generate-errors.ts",
    "generate:entity-routes": "node scripts/infra/generate-entity-routes.ts",
    "generate:operation-routes": "node scripts/backend/generate-operation-routes.ts",
    "generate:rest-client": "node scripts/sdk/generate-rest-client.ts",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run generate && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@oxlint/plugins": "^1.89.0",
    "@types/node": "^26.6.2",
    "oxlint": "^1.88.0",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
