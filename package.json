{
  "name": "test-backend",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run lint:spec",
    "lint:spec": "pnpm --filter spec run lint:spec",
    "generate": "pnpm run generate:schema && pnpm run generate:repositories && pnpm run generate:queries && pnpm run generate:validation && pnpm run generate:rest-api && pnpm run generate:rest-client",
    "spec": "pnpm run lint:spec && pnpm run generate",
    "generate:schema": "pnpm --filter backend run generate:schema",
    "generate:schema:stdout": "pnpm --filter backend run generate:schema:stdout",
    "generate:repositories": "pnpm --filter backend run generate:repositories",
    "generate:queries": "pnpm --filter backend run generate:queries",
    "generate:validation": "pnpm --filter backend run generate:validation",
    "generate:rest-api": "pnpm --filter backend run generate:rest-api",
    "generate:rest-client": "pnpm --filter backend run generate:rest-client",
    "generate:effect": "pnpm run generate:effect:schema && pnpm run generate:effect:validation && pnpm run generate:effect:repositories && pnpm run generate:effect:queries && pnpm run generate:effect:routes",
    "generate:effect:schema": "pnpm --filter backend-effect run generate:schema",
    "generate:effect:validation": "pnpm --filter backend-effect run generate:validation",
    "generate:effect:repositories": "pnpm --filter backend-effect run generate:repositories",
    "generate:effect:queries": "pnpm --filter backend-effect run generate:queries",
    "generate:effect:routes": "pnpm --filter backend-effect run generate:routes",
    "build": "pnpm -r --if-present run build",
    "check": "pnpm run lint && pnpm run generate && pnpm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.9.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
