{
  "name": "sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Generated type-safe client for the REST API, the Zod schemas and shared write/read types for the spec, and the hand-written transport and error contract.",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts"
  },
  "scripts": {
    "generate:validation": "node scripts/generate-zod-schemas.ts",
    "generate:errors": "node scripts/generate-errors.ts",
    "generate:rest-client": "node scripts/generate-rest-client.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "devalue": "^5.3.2",
    "spec": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
