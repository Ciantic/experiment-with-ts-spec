{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres schema generation and result mapping for the spec.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:schema": "node scripts/generate-postgres-schema.ts",
    "generate:schema:stdout": "node scripts/generate-postgres-schema.ts --stdout",
    "generate:repositories": "node scripts/generate-repositories.ts",
    "generate:queries": "node scripts/generate-query-metadata.ts"
  },
  "dependencies": {
    "spec": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
