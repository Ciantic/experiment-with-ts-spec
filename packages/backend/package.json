{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "The application implementation: operation logic and the process entry point over the infra package.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run build:pg && pnpm run build:pglite && pnpm run build:porffor",
    "build:pg": "vite build --mode pg",
    "build:pglite": "vite build --mode pglite",
    "build:porffor": "vite build --mode porffor",
    "start": "node src/main.pg.ts",
    "example:server": "node src/main.pglite.ts"
  },
  "dependencies": {
    "infra": "workspace:*",
    "operations": "workspace:*",
    "pg": "^8.23.1",
    "sdk": "workspace:*",
    "spec": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
