{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Postgres schema generation and result mapping for the spec.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:schema": "node scripts/generate-postgres-schema.ts",
    "generate:schema:stdout": "node scripts/generate-postgres-schema.ts --stdout",
    "generate:repositories": "node scripts/generate-repositories.ts",
    "generate:queries": "node scripts/generate-queries.ts",
    "generate:rest-api": "node scripts/generate-rest-api.ts",
    "generate:rest-client": "node scripts/generate-rest-client.ts",
    "example:server": "node src/main.ts"
  },
  "dependencies": {
    "devalue": "^5.3.2",
    "spec": "workspace:*",
    "validation": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "sdk": "workspace:*",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
