{
  "name": "backend-effect",
  "version": "1.0.0",
  "private": true,
  "description": "Effect v4 backend: Postgres schema, repositories, queries, validation, and REST API.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate:schema": "node scripts/generate-postgres-schema.ts",
    "generate:schema:stdout": "node scripts/generate-postgres-schema.ts --stdout",
    "generate:validation": "node scripts/generate-schemas.ts",
    "generate:repositories": "node scripts/generate-repositories.ts",
    "generate:queries": "node scripts/generate-queries.ts"
  },
  "dependencies": {
    "@effect/sql-pglite": "^4.0.0",
    "effect": "^4.0.0",
    "spec": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
