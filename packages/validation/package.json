{
  "name": "validation",
  "version": "1.0.0",
  "private": true,
  "description": "Generated Zod schemas, the shared Insert/Patch and read-selection types for the spec, plus the generator that writes the schemas.",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts",
    "./domain/*.ts": "./src/domain/*.ts",
    "./repositories/*.ts": "./src/repositories/*.ts",
    "./queries/*.ts": "./src/queries/*.ts",
    "./scripts/*.ts": "./scripts/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:validation": "node scripts/generate-zod-schemas.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "spec": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
