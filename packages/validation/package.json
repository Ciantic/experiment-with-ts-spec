{
  "name": "validation",
  "version": "1.0.0",
  "private": true,
  "description": "Generated Zod schemas that validate the spec at the boundary.",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./*.js": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate-zod-schemas.ts"
  },
  "dependencies": {
    "spec": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ts-morph": "^28.0.0",
    "vitest": "^5.0.2"
  }
}
