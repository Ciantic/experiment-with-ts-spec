{
  // Shared compiler options. Each package extends this and adds its own `include`.
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "lib": ["esnext"],
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Nothing is emitted: node runs the TypeScript directly, so `.ts` specifiers are allowed.
    "allowImportingTsExtensions": true,
    "noEmit": true,
  },
  // The root holds the generate driver; packages own the rest of the file lists.
  "include": ["scripts/**/*.ts"]
}
